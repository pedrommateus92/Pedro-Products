<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7204101">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <ShouldRunNpmInstall>true</ShouldRunNpmInstall>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\products-web\browser\</BuildOutputFolder>
    <DefaultItemExcludes>$(DefaultItemExcludes);coverage\**;dist\**;.angular\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
